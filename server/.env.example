# ============================================================
# 易标检查服务端配置模板
# 用法：复制为 server/.env（同目录），按需取消注释并填写。
# 优先级：真实环境变量 > .env > 代码默认值。
# 变量名规则：前缀 YIBIAO_ + 嵌套用双下划线（如 TEXT_MODEL__BASE_URL）。
# ============================================================

# ---- 数据根目录（数据库/文档/图片/导出都在这下面；默认 ./data）----
# YIBIAO_DATA_ROOT=D:/yibiao-data

# ---- 文本模型（提取/四项检查都用它；OpenAI 兼容 /chat/completions）----
# YIBIAO_TEXT_MODEL__BASE_URL=https://api.example.com/v1
# YIBIAO_TEXT_MODEL__API_KEY=sk-xxxxxxxx
# YIBIAO_TEXT_MODEL__MODEL_NAME=模型名
# YIBIAO_TEXT_MODEL__CONTEXT_LIMIT=120000
# YIBIAO_TEXT_MODEL__TIMEOUT_SECONDS=300

# ---- 视觉模型（印章检查用；不配则印章检查自动跳过）----
# YIBIAO_VISION_MODEL__BASE_URL=https://api.example.com/v1
# YIBIAO_VISION_MODEL__API_KEY=sk-xxxxxxxx
# YIBIAO_VISION_MODEL__MODEL_NAME=视觉模型名

# ---- 长文档分段上限（字符；默认 400000）----
# YIBIAO_AI_CONTEXT_LENGTH_LIMIT=400000

# ---- MinerU 在线解析（可选；默认用本地解析器）----
# YIBIAO_FILE_PARSER_PROVIDER=mineru-agent-api
# YIBIAO_MINERU_TOKEN=xxxxxxxx

# ---- 并发与性能（一般不用动）----
# YIBIAO_AI_MAX_CONCURRENCY=8
# YIBIAO_TASK_GLOBAL_CONCURRENCY=4
# YIBIAO_PROGRESS_WRITE_INTERVAL_MS=200

# ---- 前端静态目录（默认自动定位 server/web/dist）----
# YIBIAO_WEB_DIST=server/web/dist
